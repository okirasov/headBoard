# Headboard API (optional). On a physical device use the Mac's LAN address.
EXPO_PUBLIC_API_URL=http://localhost:5080
# Google OAuth clients (optional). Without them the app uses the API's development login.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

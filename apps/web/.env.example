# URL of the Headboard API (apps/api). Leave empty for local-only mode.
VITE_API_URL=http://localhost:5080

# Real sign-in (optional; without these the app uses the API's development login).
# Google: OAuth 2.0 client of type "Web application" with http://localhost:5173 in Authorized JavaScript origins.
VITE_GOOGLE_CLIENT_ID=
# Apple: Services ID from the Apple Developer portal; the redirect URI must be https and registered there.
VITE_APPLE_SERVICES_ID=
VITE_APPLE_REDIRECT_URI=
